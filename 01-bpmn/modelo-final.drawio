        <mxCell id="qb1" value="&lt;b&gt;B1&lt;/b&gt;&amp;nbsp; La nómina no admite cruce automatizado&lt;br&gt;&lt;span style='color:#6B7280'&gt;Obliga a revisar 6.400 registros a mano&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF0EF;strokeColor=#E8B4B0;align=left;spacingLeft=10;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
